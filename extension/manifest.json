{
  "manifest_version": 3,
  "name": "Replx",
  "short_name": "Replx",
  "version": "2.1.0",
  "description": "커뮤니티·뉴스·유튜브의 댓글을 숨깁니다. 숨길 곳과 숨기지 않을 곳을 클릭해서 직접 지정할 수 있어요.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Replx",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/defaults.js",
        "src/store.js",
        "src/rules.js",
        "src/detector.js",
        "src/picker.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-show": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "댓글 잠깐 보기 / 다시 숨기기"
    },
    "start-picker": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "숨길 영역 직접 지정"
    },
    "start-allow-picker": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "제외할 영역(숨기지 않을 곳) 직접 지정"
    }
  }
}
