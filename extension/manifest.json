{
  "manifest_version": 3,
  "name": "Replx - 댓글 가림막",
  "short_name": "Replx",
  "version": "0.1.0",
  "description": "커뮤니티·뉴스·유튜브의 댓글 영역을 자동으로 찾아 숨깁니다. 못 찾은 곳은 클릭해서 직접 지정할 수 있어요.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Replx - 댓글 가림막",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/defaults.js", "src/rules.js", "src/detector.js", "src/picker.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-show": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "댓글 잠깐 보기 / 다시 숨기기" },
    "start-picker": { "suggested_key": { "default": "Alt+Shift+X" }, "description": "숨길 영역 직접 지정" }
  }
}
